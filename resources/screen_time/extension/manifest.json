{
  "manifest_version": 3,
  "name": "Focuser · Screen Time",
  "version": "1.3.0.2",
  "minimum_chrome_version": "120",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "description": "Local screen-time budgets across browsers and Windows apps. Free, open source, no cloud.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Focuser"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "blocked.css",
        "intent.html",
        "intent.js",
        "i18n.js",
        "i18n.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
